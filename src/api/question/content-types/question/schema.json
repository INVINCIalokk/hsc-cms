{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Question_number": {
      "type": "string"
    },
    "Question_Text": {
      "type": "blocks"
    },
    "Solution": {
      "type": "blocks"
    },
    "Question_Type": {
      "type": "enumeration",
      "default": "Standard",
      "enum": [
        "Standard",
        "Extra"
      ]
    },
    "chapter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::chapter.chapter",
      "inversedBy": "questions"
    },
    "exercise": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::exercise.exercise",
      "inversedBy": "questions"
    }
  }
}
