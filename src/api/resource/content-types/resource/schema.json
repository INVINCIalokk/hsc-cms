{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "Resource"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "link"
          ]
        }
      },
      "required": false
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "link",
        "folder"
      ]
    },
    "resource": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::resource.resource"
    }
  }
}
