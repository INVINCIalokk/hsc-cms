{
  "kind": "collectionType",
  "collectionName": "exam_results",
  "info": {
    "singularName": "exam-result",
    "pluralName": "exam-results",
    "displayName": "ExamResult",
    "description": "Student attempt records, evaluation details, and lock security status for exams"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "exam_results"
    },
    "obtained_marks": {
      "type": "decimal"
    },
    "total_marks": {
      "type": "decimal"
    },
    "correct_count": {
      "type": "integer"
    },
    "incorrect_count": {
      "type": "integer"
    },
    "unattempted_count": {
      "type": "integer"
    },
    "accuracy_percentage": {
      "type": "decimal"
    },
    "start_time": {
      "type": "datetime"
    },
    "submit_time": {
      "type": "datetime"
    },
    "exam_result_status": {
      "type": "enumeration",
      "default": "in_progress",
      "enum": [
        "in_progress",
        "submitted",
        "evaluated"
      ]
    },
    "is_locked": {
      "type": "boolean",
      "default": false
    },
    "tab_switch_count": {
      "type": "integer",
      "default": 0
    },
    "lock_reason": {
      "type": "string"
    },
    "responses": {
      "type": "json"
    },
    "remarks": {
      "type": "enumeration",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "exam": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::exam.exam",
      "inversedBy": "exam_results"
    }
  }
}
