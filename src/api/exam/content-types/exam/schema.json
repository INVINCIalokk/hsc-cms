{
  "kind": "collectionType",
  "collectionName": "exams",
  "info": {
    "singularName": "exam",
    "pluralName": "exams",
    "displayName": "Exam",
    "description": "Scheduled exam instance linked to a question paper and batch"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "start_time": {
      "type": "datetime"
    },
    "end_time": {
      "type": "datetime"
    },
    "duration_minutes": {
      "type": "integer"
    },
    "exam_status": {
      "type": "enumeration",
      "default": "inactive",
      "enum": [
        "inactive",
        "active",
        "completed"
      ]
    },
    "total_marks": {
      "type": "integer"
    },
    "instructions": {
      "type": "blocks"
    },
    "type": {
      "type": "enumeration",
      "default": "theory",
      "enum": [
        "theory",
        "entrance"
      ]
    },
    "batch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::batch.batch",
      "inversedBy": "exams"
    },
    "exam_results": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exam-result.exam-result",
      "mappedBy": "exam"
    },
    "question_paper": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::question-paper.question-paper",
      "inversedBy": "exams"
    }
  }
}
